<rml>
<head>
	<title>HUD</title>
	<link type="text/rcss" href="hud.rcss"/>
</head>
<!-- data-model: what the game shows of the quests, see Menu::setHud in BIBO/UI/Menu.cpp -->
<body id="hud" data-model="hud">
	<!-- The race: time, checkpoints and time limit at the top -->
	<div class="race" data-if="racing">
		<div class="time">{{ race_time }}</div>
		<div class="details">Checkpoints {{ checkpoints }}<span class="separator">|</span>Limit {{ time_limit }}</div>
	</div>

	<!-- 3, 2, 1, GO! -->
	<div class="countdown" data-if="countdown != ''" data-class-go="countdown == 'GO!'">{{ countdown }}</div>

	<!-- The result of the race -->
	<div class="banner" data-if="banner != ''" data-class-success="banner_success">
		<div class="title">{{ banner }}</div>
		<div class="detail">{{ banner_detail }}</div>
	</div>

	<!-- What the player can do here -->
	<div class="prompt" data-if="prompt != '' &amp;&amp; speaker == ''"><span class="key">{{ prompt_key }}</span>{{ prompt }}</div>

	<!-- A conversation: what the animal says appears on the screen, the answers below it -->
	<div class="conversation" data-if="speaker != ''">
		<div class="speaker">{{ speaker }}</div>
		<div class="text">{{ text }}</div>
		<div class="choices" data-if="choices.size > 0">
			<span class="choice" data-for="choice : choices" data-class-selected="it_index == selected_choice">{{ choice }}</span>
		</div>
		<div class="continue" data-if="can_continue"><span class="key">{{ continue_key }}</span>Continue</div>
	</div>
</body>
</rml>
